                if (cat.strawberryFoodStock > 0) {
                  selectedFood = 1;
                  cat.strawberryFoodStock -= 1;
                  cat.score += 30;
                } else if (cat.grapeFoodStock > 0) {
                  selectedFood = 2;
                  cat.grapeFoodStock -= 1;
                  cat.score += 20;
                } else if (cat.milkFoodStock > 0) {
